@* @code {
    using Microsoft.JSInterop;

public class NotificationInterop
{
    private readonly IJSRuntime _js;

    public NotificationInterop(IJSRuntime js)
    {
        _js = js;
    }

    public async Task ScheduleNotification(string title, string body, DateTime time)
    {
        var timestamp = new DateTimeOffset(time).ToUnixTimeMilliseconds();
        await _js.InvokeVoidAsync("scheduleNotification", title, body, timestamp);
    }
}
